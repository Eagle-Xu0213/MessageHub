# ============================================================
#  MessageHub 环境配置示例
#  复制为 .env 后填写实际值；.env 已被 git 忽略，请勿提交。
#
#  密钥默认留空。当前工作台使用本地规则；保留 LLM 配置供兼容接口使用。
#  推荐在「设置 → AI 增强」填写，配置保存在 runtime/llm_settings.json；
#  这里的 .env 仅作为未使用工作台时的兼容回退。
#  邮件通知默认关闭，可在工作台的「设置 → 邮件通知」中开启。
# ============================================================

# ---------- LLM（可选，OpenAI Chat Completions 兼容接口） ----------
# 使用 OpenAI Chat Completions 兼容接口；需填写 API 密钥才启用。
# 部分请求在主服务失败后会尝试第三方备用服务，可能发送消息内容。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---------- 邮件通知（可选） ----------
# 使用本文件配置邮件时，填写以下参数并设置 MESSAGEHUB_EMAIL_ENABLED=1。
# QQ 邮箱需在「设置 → 账户」开启 SMTP 服务并获取 16 位授权码（不是登录密码）
MESSAGEHUB_EMAIL_ENABLED=0
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
BRIEF_TO=

# ---------- 应用配置 ----------
HOST=127.0.0.1
# 注意：PORT 只影响「采集器推送目标」（moect_live 推消息到哪个端口）。
# 网页服务端口由启动脚本决定（启动 MessageHub.bat 固定 8000）。
# 若你用命令行自起服务（python -m uvicorn ... --port 8001），
# 采集器才会跟随这里的 PORT 改推送目标。
PORT=8000
# 数据库路径（相对项目根或绝对路径）
DATABASE_PATH=runtime/messagehub.db

# ---------- Moect 集成（可选，仅 Windows + 微信场景需要） ----------
# 计划任务使用 Moect 源码。安装脚本会查找或下载源码，也可指定已有目录。
# MOECT_SRC=C:\Path\To\Moect-source
# 以下仅用于需要 Moect 图形程序的旧式刷新流程。
# Moect.exe 的完整路径。不填则自动探测以下位置：
#   %LOCALAPPDATA%\Programs\Moect\Moect.exe
#   %PROGRAMFILES%\Moect\Moect.exe
# 装了 Moect 但装在别处时，务必显式指定：
# MOECT_EXE=C:\Path\To\Moect\Moect.exe

# 项目根目录（一般不用填，脚本会按自身位置推导）
# MESSAGEHUB_ROOT=D:\Projects\MessageHub

# ---------- 以下仅用于 pytest 隔离，正常启动无需设置 ----------
# tests/conftest.py 会自动配置，手填反而容易误指到生产库
# MESSAGEHUB_DB_PATH=...
# MESSAGEHUB_WATCH_DIR=...
