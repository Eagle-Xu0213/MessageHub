# 默认按文本处理，保证跨平台换行一致
* text=auto eol=lf

# Windows 批处理必须 CRLF，否则 cmd 解析可能出错
*.bat text eol=crlf
*.cmd text eol=crlf

# VBScript 也用 CRLF
*.vbs text eol=crlf

# 二进制文件不做换行转换
*.db binary
*.sqlite binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary

# 中文文档在 GitHub 上按文本渲染
*.md text eol=lf
*.json text eol=lf
